rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /animatronics/{animatronicId} {
      function isOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }
      function validFields() {
        return request.resource.data.keys().hasOnly(['nome', 'jogo', 'tipo', 'comportamento', 'descricao', 'ownerUid', 'criadoEm', 'atualizadoEm'])
          && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 70
          && request.resource.data.jogo is string && request.resource.data.jogo.size() > 0 && request.resource.data.jogo.size() <= 90
          && request.resource.data.tipo is string && request.resource.data.tipo.size() <= 50
          && request.resource.data.comportamento is string && request.resource.data.comportamento.size() <= 350
          && request.resource.data.descricao is string && request.resource.data.descricao.size() > 0 && request.resource.data.descricao.size() <= 500;
      }
      allow read, delete: if isOwner();
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && validFields()
        && request.resource.data.criadoEm == request.time;
      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.atualizadoEm == request.time
        && validFields();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
